# telegram/watchdog.env.example — template for the Telegram-assistant watchdog.
#
# COPY this file to state/telegram-watchdog.env (gitignored — it may hold the
# bot token) and fill it in there. The identification prompt in
# telegram/README.md walks a desktop Claude session through discovering these
# values. Never commit the filled-in copy.

# REQUIRED unless ASSISTANT_LAUNCHD_LABEL is set — command that starts the
# Telegram<->Claude bridge in the FOREGROUND (launchd supervises it; it must
# not daemonize/fork itself). Avoid &, <, > characters in the command; wrap
# anything complex in a small script and point this at the script.
# Example: "/usr/bin/env node /Users/anthonyflores/code/telegram-bridge/index.js"
ASSISTANT_START_CMD=""

# REQUIRED — pattern uniquely matching the bridge process (checked with
# `pgrep -f`). Example: "telegram-bridge/index.js"
ASSISTANT_PROCESS_PATTERN=""

# OPTIONAL — if the bridge ALREADY has its own LaunchAgent (its own launchctl
# label), put that label here. The installer then skips creating a supervisor
# agent and the watchdog kickstarts this label instead. Leave empty to let
# this kit supervise ASSISTANT_START_CMD itself.
ASSISTANT_LAUNCHD_LABEL=""

# OPTIONAL — working directory for ASSISTANT_START_CMD (default: $HOME).
ASSISTANT_WORKDIR=""

# OPTIONAL — the bot's Telegram token (from BotFather, or the bridge's own
# config). Lets the watchdog distinguish "bridge died" from "Telegram
# unreachable" by calling https://api.telegram.org/bot<token>/getMe, so a
# network outage is logged instead of triggering restart loops.
TELEGRAM_BOT_TOKEN=""

# OPTIONAL — a command that exits 0 when the bridge is healthy end-to-end.
# Two consecutive failures force-restart the bridge even if the process is
# still up (catches wedged long-poll connections). Example: a status CLI the
# bridge ships with.
ASSISTANT_HEALTH_CMD=""
